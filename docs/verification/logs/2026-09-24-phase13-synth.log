## appendix: cache_replay.py
"""Replay the run's `gen task` request through workbench's synthesis proxy against the run's own
LLM cache, WITHOUT an upstream key: a cache hit is served locally; a miss would reach DeepSeek
unauthenticated (401, nothing billed). Writes only to scratch, never to the run directory."""
import json, os, socket, sys
from pathlib import Path

from workbench.config import Settings
from workbench.synth.ledger import Ledger
from workbench.synth.proxy import create_proxy_app
from workbench.synth.runner import ProxyThread, SynthRunner, default_command_runner

run_dir = Path("data/synth/p13_it_service_desk")
scratch = Path(sys.argv[1])
ledger = Ledger(scratch / "replay_ledger.jsonl")
with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
app = create_proxy_app(
    upstream_base_url="https://api.deepseek.com",
    upstream_api_key=None,  # no key: a cache miss cannot be billed
    cache_dir=run_dir / "llm_cache",
    ledger=ledger,
    max_retries=0,
)
runner = SynthRunner(
    Settings(), run_dir, scenarios=1, scenario_file=run_dir / "local_scenario.jsonl",
    environ={"AWM_SYN_OVERRIDE_MODEL": "deepseek-flash", "PATH": os.environ["PATH"]},
)
step = next(s for s in runner.plan if s.name == "task")
argv = list(step.argv)
argv[argv.index("--output") + 1] = str((scratch / "replay_gen_tasks.jsonl").resolve())
print("replayed step: gen task; argv:", " ".join(argv[1:]))
with ProxyThread(app, "127.0.0.1", port) as base:
    rc = default_command_runner(argv, runner.step_env("task", base), scratch / "replay_task.log")
print("returncode:", rc)
entries = [json.loads(l) for l in (scratch / "replay_ledger.jsonl").read_text().splitlines() if l.strip()]
print("replay ledger:", entries)
orig = [json.loads(l) for l in (run_dir / "gen_tasks.jsonl").read_text().splitlines() if l.strip()]
new = [json.loads(l) for l in (scratch / "replay_gen_tasks.jsonl").read_text().splitlines() if l.strip()]
print("replayed tasks identical to the run's gen_tasks.jsonl:", orig == new)
