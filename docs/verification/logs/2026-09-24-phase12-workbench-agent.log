# 2026-09-24 Phase 12 step 2: one real-LLM 'workbench agent run' (TASK_v2 N2: single run, single task; chain evidence only, not an evaluation)
# machine: Claude Code cloud container (Linux x86_64, no GPU). Key read from DEEPSEEK_API_KEY by name; never printed.
# scenario: official e_commerce_33 (AgentWorldModel-1K revision dde80a0, CC-BY-4.0), task index 0, request = task text verbatim

## configuration (process environment only; no .env file)
PYTHONPYCACHEPREFIX=$PWD/.cache/pycache
WORKBENCH_LLM__BACKEND=openai_compat
WORKBENCH_LLM__BASE_URL=https://api.deepseek.com
WORKBENCH_LLM__MODEL=deepseek-flash              # DeepSeek default thinking mode (enabled, effort high) left unchanged
WORKBENCH_LLM__API_KEY_ENV=DEEPSEEK_API_KEY
WORKBENCH_LLM__MAX_TOKENS=8192                   # default 2048; DeepSeek counts reasoning tokens in completion_tokens
WORKBENCH_AGENT__TOKEN_BUDGET=400000             # default 60000; one act call on this 39-tool scenario is ~26K tokens
WORKBENCH_ENV__RUNS_DIR=data/p12/runs
WORKBENCH_GATEWAY__AUDIT_PATH=data/p12/audit.jsonl
WORKBENCH_AGENT__CHECKPOINT_DB=data/p12/checkpoints.sqlite
WORKBENCH_AGENT__MEMORY_DB=data/p12/memory.sqlite

## command
$ time uv run workbench agent run "<e_commerce_33 task 0>" --scenario e_commerce_33 --approve auto --approver claude-code-operator
# approval: decided in advance by the operator (Claude Code) for this demo; the gate itself still pauses the graph,
# records approval_requested/approval_granted and issues a one-time token for the write call.

