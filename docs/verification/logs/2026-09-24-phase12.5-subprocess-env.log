## appendix: scan_env_reads.py
"""Offline scan of official env code: which env vars it reads, which network clients it imports."""
import json, re, sys
from collections import Counter
from pathlib import Path

path = Path(sys.argv[1])
ENV_READ = re.compile(r"""os\.(?:environ\.get|getenv|environ\[)\s*\(?\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]""")
ENV_WHOLE = re.compile(r"os\.environ(?!\s*(?:\.get|\[))")
NET = re.compile(r"^\s*(?:import|from)\s+(requests|httpx|urllib|urllib3|aiohttp|socket|http\.client|smtplib|ftplib|subprocess)\b", re.M)
names, nets, whole, per = Counter(), Counter(), 0, {}
total = 0
for line in path.open(encoding="utf-8"):
    if not line.strip():
        continue
    r = json.loads(line); total += 1
    code = r.get("full_code", "")
    reads = set(ENV_READ.findall(code))
    names.update(reads)
    nets.update(set(NET.findall(code)))
    if ENV_WHOLE.search(code):
        whole += 1
    if r["scenario"] in ("e_commerce_33",):
        per[r["scenario"]] = {"env_reads": sorted(reads), "net_imports": sorted(set(NET.findall(code))), "whole_environ": bool(ENV_WHOLE.search(code))}
print(json.dumps({"scenarios": total, "env_var_reads": dict(names.most_common()), "network_or_process_imports": dict(nets), "whole_environ_access": whole, "e_commerce_33": per.get("e_commerce_33")}, indent=1))
