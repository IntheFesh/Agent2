## appendix: count_risk.py
"""Join the risk table exported by the old code (37fce26) with the new one; count what the floor changed."""
import csv, collections, sys
before = {(r["scenario"], r["tool"]): r for r in csv.DictReader(open(sys.argv[1], encoding="utf-8"))}
after = {(r["scenario"], r["tool"]): r for r in csv.DictReader(open(sys.argv[2], encoding="utf-8"))}
assert before.keys() == after.keys(), "tool sets differ"
WRITE = {"POST", "PUT", "PATCH", "DELETE"}
methods = collections.Counter(r["http_method"] or "(none)" for r in after.values())
print("tools:", len(after), "| by method:", dict(sorted(methods.items())))
old_read_writes = sum(1 for k, r in after.items() if r["http_method"] in WRITE and before[k]["risk"] == "read")
new_read_writes = sum(1 for r in after.values() if r["http_method"] in WRITE and r["risk"] == "read")
print(f"write-method tools graded read: before (old code) {old_read_writes}, after {new_read_writes}")
trans = collections.Counter((before[k]["risk"], r["risk"]) for k, r in after.items() if before[k]["risk"] != r["risk"])
print("level changes (before -> after):", dict(trans))
print("newly requiring approval:", sum(1 for k, r in after.items() if before[k]["requires_approval"] == "False" and r["requires_approval"] == "True"))
print("no longer requiring approval:", sum(1 for k, r in after.items() if before[k]["requires_approval"] == "True" and r["requires_approval"] == "False"))
print("heuristic_risk column == old risk for every tool:", all(before[k]["risk"] == r["heuristic_risk"] for k, r in after.items()))
