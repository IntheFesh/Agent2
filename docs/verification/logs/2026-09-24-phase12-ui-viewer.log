# 2026-09-24 Phase 12 step 3: open the real 'awm agent' output in the UI trajectory viewer (no LLM involved)
# UI served by the offline demo API (uv run workbench api serve --demo, mock LLM); headless Chromium via Playwright
# (uv run --with playwright: an ephemeral overlay, not an app dependency; browser /opt/pw-browsers/chromium-1194).
# Input files: the untrimmed data/p12/awm-agent/e_commerce_33_task_0/trajectory.json and the workbench trace of step 2.

## script
"""Load real outputs into the UI trajectory viewer (client-side only; no LLM involved)."""
import sys
from playwright.sync_api import sync_playwright

traj, trace, shots = sys.argv[1], sys.argv[2], sys.argv[3]
with sync_playwright() as p:
    b = p.chromium.launch(executable_path="/opt/pw-browsers/chromium-1194/chrome-linux/chrome")
    page = b.new_page(viewport={"width": 1400, "height": 900})
    errors: list[str] = []
    page.on("pageerror", lambda e: errors.append(str(e)))
    page.goto("http://127.0.0.1:8080/ui/")
    page.click("button[data-tab=viewer]")
    for label, path in (("awm agent trajectory.json", traj), ("workbench trace.jsonl", trace)):
        page.set_input_files("#traj-file", path)
        page.wait_for_selector("#viewer p", timeout=10000)
        page.wait_for_timeout(300)
        text = page.inner_text("#viewer")
        print(f"=== {label}: {path}")
        print("steps rendered (.viewer-step):", page.locator("#viewer .viewer-step").count(),
              "| timeline items:", page.locator("#viewer li").count())
        print(text[:1500])
        page.screenshot(path=f"{shots}/viewer_{label.split()[0]}.png", full_page=True)
    print("page errors:", errors or "none")
    b.close()

## command
$ PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers uv run --with playwright python viewer_check.py <trajectory.json> <trace.jsonl> <shots_dir>

