## appendix: probe scripts (verbatim; the key is read from the environment by name)
### probe.py (P1, P2)
"""Protocol probe of DeepSeek through workbench's OpenAICompatBackend (streaming, as the agent uses it).

P1: default thinking mode + tools; the 2nd request omits reasoning_content (as the agent does) -> expect HTTP 400.
P2: thinking disabled via extra_body; real e_commerce_33 tool schemas; 2-turn tool exchange -> expect success.
The API key is read from DEEPSEEK_API_KEY by the backend and never printed.
"""
import asyncio, json, os, time
from pathlib import Path
from workbench.llm.backends.openai_compat import OpenAICompatBackend
from workbench.llm.errors import LLMError

S = Path("<scratchpad>/p12")
BASE, MODEL = "https://api.deepseek.com", "deepseek-flash"
TINY = [{"name": "get_utc_time", "description": "Return the current UTC time.", "input_schema": {"type": "object", "properties": {}}}]
usage: list[dict] = []

def backend(extra: dict | None) -> OpenAICompatBackend:
    return OpenAICompatBackend(name="openai_compat", base_url=BASE, model=MODEL, api_key=os.environ["DEEPSEEK_API_KEY"],
                               connect_timeout_s=10, read_timeout_s=120, stream=True, extra_body=extra)

def e33_tools() -> list[dict]:
    native = json.loads((S / "e33_native_tools.json").read_text())
    return [{"name": t["function"]["name"], "description": t["function"]["description"],
             "input_schema": t["function"]["parameters"]} for t in native]

async def two_turns(label: str, extra: dict | None, tools: list[dict], question: str, fake_result: str) -> None:
    b = backend(extra)
    try:
        msgs = [{"role": "user", "content": question}]
        t0 = time.perf_counter()
        r1 = await b.chat(msgs, tools, temperature=0.6, max_tokens=2048)
        usage.append({"probe": label, "req": 1, "prompt": r1.usage.prompt_tokens, "completion": r1.usage.completion_tokens})
        print(f"{label} req1: {time.perf_counter()-t0:.1f}s finish={r1.finish_reason} tool_calls={[(c.name, c.arguments) for c in r1.tool_calls]} "
              f"content={r1.content[:120]!r} usage={r1.usage}")
        if not r1.tool_calls:
            print(f"{label}: no tool call, stop"); return
        tc = r1.tool_calls[0]
        msgs += [{"role": "assistant", "content": r1.content,
                  "tool_calls": [{"id": tc.id, "type": "function", "function": {"name": tc.name, "arguments": json.dumps(tc.arguments)}}]},
                 {"role": "tool", "tool_call_id": tc.id, "content": fake_result}]
        t0 = time.perf_counter()
        try:
            r2 = await b.chat(msgs, tools, temperature=0.6, max_tokens=2048)
            usage.append({"probe": label, "req": 2, "prompt": r2.usage.prompt_tokens, "completion": r2.usage.completion_tokens})
            print(f"{label} req2: {time.perf_counter()-t0:.1f}s finish={r2.finish_reason} tool_calls={[(c.name, c.arguments) for c in r2.tool_calls]} "
                  f"content={r2.content[:200]!r} usage={r2.usage}")
        except LLMError as exc:
            print(f"{label} req2: {type(exc).__name__}: {exc}")
    finally:
        await b.aclose()

async def main() -> None:
    print("start", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    await two_turns("P1 thinking=default", None, TINY, "What is the current UTC time? Use the tool.",
                    json.dumps({"status": "ok", "result": "2026-09-24T17:05:00Z"}))
    await two_turns("P2 thinking=disabled", {"thinking": {"type": "disabled"}}, e33_tools(),
                    "Which top-level product categories exist? Use a tool.",
                    json.dumps({"status": "ok", "result": {"categories": [{"id": 1, "name": "Electronics"}]}}))
    print("usage", json.dumps(usage))
    print("end", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))

asyncio.run(main())

### probe3.py (P3)
"""P3: explicit thinking mode, raw HTTP streaming; capture reasoning_content; then omit it in request 2."""
import json, os, time
import httpx

URL = "https://api.deepseek.com/chat/completions"
H = {"Authorization": f"Bearer {os.environ['DEEPSEEK_API_KEY']}"}
TOOLS = [{"type": "function", "function": {"name": "record_answer", "description": "Record the final numeric answer.",
          "parameters": {"type": "object", "properties": {"value": {"type": "number"}}, "required": ["value"]}}}]
usage = []

def stream(messages):
    body = {"model": "deepseek-flash", "messages": messages, "tools": TOOLS, "stream": True,
            "stream_options": {"include_usage": True}, "max_tokens": 2048, "thinking": {"type": "enabled"}}
    reasoning, content, calls, u, finish = [], [], {}, None, None
    with httpx.stream("POST", URL, json=body, headers=H, timeout=120) as r:
        if r.status_code >= 400:
            return {"http_status": r.status_code, "error_body": r.read().decode()[:600]}
        for line in r.iter_lines():
            if not line.startswith("data:"): continue
            data = line[5:].strip()
            if data == "[DONE]": break
            ch = json.loads(data)
            if ch.get("usage"): u = ch["usage"]
            for c in ch.get("choices") or []:
                d = c.get("delta") or {}
                if d.get("reasoning_content"): reasoning.append(d["reasoning_content"])
                if d.get("content"): content.append(d["content"])
                for tc in d.get("tool_calls") or []:
                    s = calls.setdefault(tc.get("index", 0), {"id": None, "name": "", "arguments": ""})
                    s["id"] = tc.get("id") or s["id"]; fn = tc.get("function") or {}
                    s["name"] += fn.get("name") or ""; s["arguments"] += fn.get("arguments") or ""
                finish = c.get("finish_reason") or finish
    return {"http_status": 200, "reasoning_chars": len("".join(reasoning)), "reasoning": "".join(reasoning),
            "content": "".join(content), "tool_calls": list(calls.values()), "usage": u, "finish": finish}

print("start", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
msgs = [{"role": "user", "content": "Compute 17*23 + 19*21 step by step, then call record_answer with the result."}]
r1 = stream(msgs)
print("req1:", {k: (v if k != "reasoning" else v[:160]) for k, v in r1.items()})
if r1.get("tool_calls"):
    tc = r1["tool_calls"][0]
    base = [*msgs, {"role": "assistant", "content": r1["content"],
                    "tool_calls": [{"id": tc["id"], "type": "function", "function": {"name": tc["name"], "arguments": tc["arguments"]}}]},
            {"role": "tool", "tool_call_id": tc["id"], "content": "recorded"}]
    r2 = stream(base)  # reasoning_content omitted, like workbench's act node
    print("req2 (reasoning_content omitted):", {k: (v if k != "reasoning" else v[:160]) for k, v in r2.items()})
print("end", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
