## appendix: scan_write_as_read.py
"""Static scan (no LLM): official write-method routes whose operation_id the policy grades as `read`."""
import json, re, collections
from pathlib import Path
from workbench.gateway.policy import PolicyConfig, classify

policy = PolicyConfig.load(Path("configs/tool_policy.yaml"))
ROUTE = re.compile(r'@app\.(get|post|put|patch|delete)\((.*?)\)\s*\n\s*(?:async\s+)?def\s+(\w+)', re.S)
OPID = re.compile(r'operation_id\s*=\s*["\'](\w+)["\']')
SUMMARY = re.compile(r'summary\s*=\s*["\']([^"\']*)["\']')
RESP = re.compile(r'response_model\s*=\s*([\w\[\], ]+?)\s*(?:,|$)')
CLASS = re.compile(r'^class\s+(\w+)\((?:BaseModel|[\w.]+)\):\s*\n((?:[ \t]+.*\n|\s*\n)*)', re.M)
FIELD = re.compile(r'^[ \t]+(\w+)\s*:\s*([^=\n]+)', re.M)

def model_kind(code: str, name: str) -> str:
    classes = {m.group(1): m.group(2) for m in CLASS.finditer(code)}
    if name.startswith(("List[", "list[")):
        return "list"
    body = classes.get(name)
    if body is None:
        return "unparsed"
    kinds = []
    for f, typ in FIELD.findall(body):
        typ = typ.strip()
        if typ.startswith(("List[", "list[", "Optional[List[", "Optional[list[")):
            kinds.append("list")
        elif typ.split("[")[0] in classes or typ.startswith(("Dict", "dict", "Optional[Dict")) or any(
                typ.startswith(f"Optional[{c}]") for c in classes):
            kinds.append("object")
        else:
            kinds.append("scalar")
    if "object" in kinds:
        return "has_object"
    return "lists_and_scalars" if "list" in kinds else "scalars_only"

stats = collections.Counter(); examples = []
for line in open("data/awm1k/gen_envs.jsonl", encoding="utf-8"):
    env = json.loads(line); code = env["full_code"]
    for m in ROUTE.finditer(code):
        method, args, fn = m.group(1), m.group(2), m.group(3)
        if method == "get":
            continue
        op = (OPID.search(args) or [None, fn])[1]
        stats["write_method_routes"] += 1
        summ = SUMMARY.search(args)
        lvl_name = classify(op, "", policy, env["scenario"]).level
        lvl_desc = classify(op, summ.group(1) if summ else "", policy, env["scenario"]).level
        if lvl_name == "read":
            stats["graded_read_by_name"] += 1
        if lvl_desc == "read":
            stats["graded_read_with_summary_word"] += 1
            rm = RESP.search(args)
            kind = model_kind(code, rm.group(1).strip()) if rm else "no_response_model"
            stats[f"graded_read__response_{kind}"] += 1
            if len(examples) < 8:
                examples.append((env["scenario"], method.upper(), op, kind))
print(json.dumps(stats, indent=1))
for e in examples: print(e)
